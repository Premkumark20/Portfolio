# Environment Variables for Portfolio Website
# Data Source: Local CSV (/data/portfolio.csv) & Supabase Cloud Sync

# Supabase Cloud Database Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Administrator Credentials (Default / Environment Fallback)
# - Default Admin: premkumar / premkumarofficial (Salt: default_auth)
# - Master Recovery: admin / admin2615 (Salt: master_recovery)
VITE_ADMIN_USERNAME=premkumar
VITE_ADMIN_PASSWORD=your_password
